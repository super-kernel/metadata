{
    "name": "super-kernel/metadata",
    "description": "Read-only restoration of build-generated package metadata for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "super-kernel/attribute": "self.version",
        "super-kernel/contract": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Metadata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Metadata\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
